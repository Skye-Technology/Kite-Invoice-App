# Postgres (matches docker-compose.yml defaults for local dev — host port 5433 to avoid
# clashing with other local Postgres containers on the default 5432)
DATABASE_URL="postgresql://kite:kite@localhost:5433/kite"

# Auth
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
KITE_OPERATOR_EMAIL="operator@example.com"
# Only used by prisma/seed.ts to set the initial operator password (defaults to "changeme")
KITE_SEED_PASSWORD="changeme"
# Required for `npm run start` / the Dockerized app (production mode) — Auth.js v5 rejects
# the request's Host header in production unless explicitly trusted. Not needed for
# `npm run dev`. Safe here since Kite sits behind no reverse proxy of its own.
AUTH_TRUST_HOST="true"
# Also production-mode only — the externally-reachable URL, so post-sign-in redirects
# don't leak an internal container hostname. Match whatever port you actually browse to.
AUTH_URL="http://localhost:3010"

# S3-compatible object storage (MinIO locally via docker-compose, S3/R2 in production)
# Host port 9010 (console 9011) to avoid clashing with other local MinIO/services on 9000.
STORAGE_ENDPOINT="http://localhost:9010"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="kite-attachments"
STORAGE_ACCESS_KEY_ID="kite"
STORAGE_SECRET_ACCESS_KEY="kite-secret"
STORAGE_FORCE_PATH_STYLE="true"
STORAGE_PUBLIC_URL="http://localhost:9010/kite-attachments"
